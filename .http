### Получить токен по данным из телеграмма
POST http://localhost:8080/api/v1/auth
Content-Type: application/json

{
  "authDate": 0,
  "firstName": "",
  "id": 0,
  "lastName": "",
  "username": "",
  "hash": ""
}

> {%
    client.global.set("access_token", response.body['token'])
 %}

### Получить список товаров
GET http://localhost:8080/api/v1/items

### Проверка CORS
OPTIONS http://localhost:8080/api/v1/items
Access-Control-Request-Method: GET
Origin: http://localhost:4200

### Получить полную информацию о товаре
GET http://localhost:8080/api/v1/items/{{item_id}}

### Создать новый товар
POST http://localhost:8080/api/v1/items
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "Тестовое название",
  "description": "Тестовое описание\n{{$random.uuid}}",
  "price": 900,
  "categoryId": "49792d73-f64e-4e46-9845-d6c10fa612c2",
  "deliveryAddresses": [
    "cbe0c47d-731a-4d5c-ac48-2e76dbc87719"
  ],
  "pictures": [
    "74f48dcc-63d9-4d15-a826-bc6ab94190f8"
  ]
}

> {%
    client.global.set("item_id", response.body["id"])
 %}

### Изменить товар
PUT http://localhost:8080/api/v1/items/{{item_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "Новое название",
  "published": true,
  "deliveryAddresses": [
    "cbe0c47d-731a-4d5c-ac48-2e76dbc87719",
    "a9383bec-8ffb-4d96-8296-bc91647ea28d"
  ]
}

### Удалить товар
DELETE http://localhost:8080/api/v1/items/{{item_id}}
Authorization: Bearer {{access_token}}

### Получить список категорий в виде дерева
GET http://localhost:8080/api/v1/categories/tree

### Получение списка мест доставки
GET http://localhost:8080/api/v1/locations

### Получение конкретного места доставки
GET http://localhost:8080/api/v1/locations/{{location_id}}

### Создание нового места доставки
POST http://localhost:8080/api/v1/locations
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "НВК 1",
  "latitude": 56.771573,
  "longitude": 60.762416
}

> {%
    client.global.set("location_id", response.body["id"])
%}

### Изменение места доставки
PUT http://localhost:8080/api/v1/locations/{{location_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "НВК №2"
}

### Ошибочное изменение места доставки
PUT http://localhost:8080/api/v1/locations/{{$random.uuid}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "НВК 2"
}

### Удаление места доставки
DELETE http://localhost:8080/api/v1/locations/{{location_id}}
Authorization: Bearer {{access_token}}

###
DELETE http://localhost:8080/api/v1/pictures/74f48dcc-63d9-4d15-a826-bc6ab94190f8
Authorization: Bearer {{access_token}}